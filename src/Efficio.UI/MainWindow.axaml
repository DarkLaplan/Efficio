<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Efficio.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="800"
        x:Class="Efficio.UI.MainWindow"
        Title="Efficio"
        Background="#1E1E1E"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">
    
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>
        
        <Style Selector="Button.closeButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        
        <Style Selector="Button.closeButton:pointerover">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,4*,4*,2*">
        <!-- Header with close button -->
        <Border Grid.Row="0" 
                Background="#252526"
                BorderBrush="#D4AF37"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                          Text="Efficio"
                          VerticalAlignment="Center"
                          Margin="8,0"
                          FontWeight="SemiBold"
                          FontSize="14"
                          Foreground="#E4E4E7"/>
                <Button Grid.Column="1"
                        Classes="closeButton"
                        Content="×"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
        
        <!-- LongTerm Tasks (40%) -->
        <controls:LongTermTasksControl Grid.Row="1"/>
        
        <!-- ShortTerm Tasks (40%) -->
        <controls:ShortTermTasksControl Grid.Row="2"/>
        
        <!-- Active Task (20%) -->
        <controls:ActiveTaskControl Grid.Row="3"/>
    </Grid>
</Window>
