<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="800"
        x:Class="Efficio.UI.MainWindow"
        Title="Efficio"
        Background="#1E1E1E"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">
    
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>
        
        <Style Selector="Button.dockButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
        </Style>
        
        <Style Selector="Button.dockButton:pointerover">
            <Setter Property="Background" Value="#2A2A2E"/>
        </Style>
        
        <Style Selector="Button.dockButton:pressed">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
        
        <Style Selector="Button.closeButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        
        <Style Selector="Button.closeButton:pointerover">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
        </Style>
        
        <Style Selector="Separator">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header with close button -->
        <Border Grid.Row="0" 
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                          Text="Efficio"
                          VerticalAlignment="Center"
                          Margin="8,0"
                          FontWeight="SemiBold"
                          FontSize="14"
                          Foreground="#E4E4E7"/>
                <Button Grid.Column="1"
                        Classes="closeButton"
                        Content="×"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
        
        <!-- Content area -->
        <ScrollViewer Grid.Row="1" 
                     Padding="8">
            <StackPanel Spacing="8">
                <TextBlock Text="Quick Actions" 
                          FontWeight="SemiBold" 
                          Margin="8,8,8,4"
                          Foreground="#A1A1AA"/>
                
                <Button Classes="dockButton" 
                        Content="📋 New Task"
                        Click="NewTask_Click"/>
                
                <Button Classes="dockButton" 
                        Content="📁 Open Project"
                        Click="OpenProject_Click"/>
                
                <Button Classes="dockButton" 
                        Content="⚙️ Settings"
                        Click="Settings_Click"/>
                
                <Separator Margin="8,12"/>
                
                <TextBlock Text="Recent Items" 
                          FontWeight="SemiBold" 
                          Margin="8,8,8,4"
                          Foreground="#A1A1AA"/>
                
                <Button Classes="dockButton" 
                        Content="📄 Document 1"
                        Click="RecentItem_Click"/>
                
                <Button Classes="dockButton" 
                        Content="📄 Document 2"
                        Click="RecentItem_Click"/>
                
                <Button Classes="dockButton" 
                        Content="📄 Document 3"
                        Click="RecentItem_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
