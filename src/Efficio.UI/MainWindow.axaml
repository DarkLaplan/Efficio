<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Efficio.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="800"
        x:Class="Efficio.UI.MainWindow"
        Title="Efficio"
        Background="#1E1E1E"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">
    
    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>
        
        <Style Selector="Button.closeButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        
        <Style Selector="Button.closeButton:pointerover">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="Button.toolbarButton">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        
        <Style Selector="Button.toolbarButton:pointerover">
            <Setter Property="Background" Value="#2A2A2E"/>
        </Style>
        
        <Style Selector="Button.toolbarButton:pressed">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header with close button - spans both columns -->
        <Border Grid.Row="0" 
                Background="#252526"
                BorderBrush="#D4AF37"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                          Text="Efficio"
                          VerticalAlignment="Center"
                          Margin="8,0"
                          FontWeight="SemiBold"
                          FontSize="14"
                          Foreground="#E4E4E7"/>
                <Button Grid.Column="1"
                        Classes="closeButton"
                        Content="×"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
        
        <!-- Main content area with tasks and toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0" RowDefinitions="4*,4*,2*">
                <!-- LongTerm Tasks (40%) -->
                <controls:LongTermTasksControl x:Name="LongTermTasksControl" Grid.Row="0"/>
                
                <!-- ShortTerm Tasks (40%) -->
                <controls:ShortTermTasksControl x:Name="ShortTermTasksControl" Grid.Row="1"/>
                
                <!-- Active Task (20%) -->
                <controls:ActiveTaskControl Grid.Row="2"/>
            </Grid>
            
            <!-- Vertical Toolbar on the right -->
            <Border Grid.Column="1" 
                    Background="#1E1E1E"
                    BorderBrush="#D4AF37"
                    BorderThickness="1,0,0,0"
                    Width="56">
                <StackPanel VerticalAlignment="Top"
                           Margin="4,8">
                <!-- Add Task Button -->
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Add Task"
                        Click="AddTaskButton_Click">
                    <Viewbox Width="24" Height="24">
                        <Path Fill="#E4E4E7" 
                              Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </Viewbox>
                </Button>
                
                <!-- Settings Button -->
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Settings">
                    <Viewbox Width="24" Height="24">
                        <Path Fill="#E4E4E7" 
                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                    </Viewbox>
                </Button>
                
                <!-- Calendar Button -->
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Calendar">
                    <Viewbox Width="24" Height="24">
                        <Path Fill="#E4E4E7" 
                              Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"/>
                    </Viewbox>
                </Button>
                
                <!-- Statistics Button -->
                <Button Classes="toolbarButton"
                        ToolTip.Tip="Statistics">
                    <Viewbox Width="24" Height="24">
                        <Path Fill="#E4E4E7" 
                              Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z"/>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
