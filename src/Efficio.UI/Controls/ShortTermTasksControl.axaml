<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="300"
             x:Class="Efficio.UI.Controls.ShortTermTasksControl">
    
    <UserControl.Styles>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D4AF37"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        
        <Style Selector="Expander /template/ ToggleButton">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <Style Selector="Expander /template/ ToggleButton:pointerover">
            <Setter Property="Background" Value="#2A2A2E"/>
        </Style>
        
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#2A2A2E"/>
        </Style>
        
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
        
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#52525B"/>
        </Style>
        
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#D4AF37" 
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="ShortTerm"
                      Foreground="#E4E4E7"
                      FontWeight="SemiBold"/>
        </Border>
        
        <Border Grid.Row="1" 
                Background="#1E1E1E" 
                BorderBrush="#D4AF37" 
                BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="ShortTermListBox"
                        SelectionMode="Single">
                    <!-- Placeholder items - will be data-bound later -->
                    <ListBoxItem Content="Sample Short-term Task 1"/>
                    <ListBoxItem Content="Sample Short-term Task 2"/>
                    <ListBoxItem Content="Sample Short-term Task 3"/>
                    <ListBoxItem Content="Sample Short-term Task 4"/>
                    <ListBoxItem Content="Sample Short-term Task 5"/>
                    <ListBoxItem Content="Sample Short-term Task 6"/>
                    <ListBoxItem Content="Sample Short-term Task 7"/>
                    <ListBoxItem Content="Sample Short-term Task 8"/>
                    <ListBoxItem Content="Sample Short-term Task 9"/>
                    <ListBoxItem Content="Sample Short-term Task 10"/>
                    <ListBoxItem Content="Sample Short-term Task 11"/>
                    <ListBoxItem Content="Sample Short-term Task 12"/>
                    <ListBoxItem Content="Sample Short-term Task 13"/>
                    <ListBoxItem Content="Sample Short-term Task 14"/>
                    <ListBoxItem Content="Sample Short-term Task 15"/>
                    <ListBoxItem Content="Sample Short-term Task 16"/>
                    <ListBoxItem Content="Sample Short-term Task 17"/>
                    <ListBoxItem Content="Sample Short-term Task 18"/>
                    <ListBoxItem Content="Sample Short-term Task 19"/>
                    <ListBoxItem Content="Sample Short-term Task 20"/>
                </ListBox>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
