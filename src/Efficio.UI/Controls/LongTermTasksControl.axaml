<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="300"
             x:Class="Efficio.UI.Controls.LongTermTasksControl">
    
    <UserControl.Styles>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D4AF37"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        
        <Style Selector="Expander /template/ ToggleButton">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <Style Selector="Expander /template/ ToggleButton:pointerover">
            <Setter Property="Background" Value="#2A2A2E"/>
        </Style>
        
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>
        
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#2A2A2E"/>
        </Style>
        
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#3F3F46"/>
        </Style>
        
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#52525B"/>
        </Style>
        
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="#252526"
                BorderBrush="#D4AF37" 
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="LongTerm"
                      Foreground="#E4E4E7"
                      FontWeight="SemiBold"/>
        </Border>
        
        <Border Grid.Row="1" 
                Background="#1E1E1E" 
                BorderBrush="#D4AF37" 
                BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="LongTermListBox"
                        SelectionMode="Single">
                    <!-- Placeholder items - will be data-bound later -->
                    <ListBoxItem Content="Sample Long-term Task 1"/>
                    <ListBoxItem Content="Sample Long-term Task 2"/>
                    <ListBoxItem Content="Sample Long-term Task 3"/>
                    <ListBoxItem Content="Sample Long-term Task 4"/>
                    <ListBoxItem Content="Sample Long-term Task 5"/>
                    <ListBoxItem Content="Sample Long-term Task 6"/>
                    <ListBoxItem Content="Sample Long-term Task 7"/>
                    <ListBoxItem Content="Sample Long-term Task 8"/>
                </ListBox>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
